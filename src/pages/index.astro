---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(
  await getCollection("posts", ({ data }) => !data.draft)
);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout title="Ruixi Zhang" lang="en">
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout home-page"
  >
    <section class="home-intro" aria-labelledby="home-title">
      <h1 id="home-title">
        Hi, I'm Ruixi Zhang <span class="chinese-name">(张睿曦)</span>.
      </h1>
      <p>
        I'm a second-year Master's student in Computer Science at the Institute
        of Computing Technology, Chinese Academy of Sciences.
      </p>
      <p>
        My interests lie in ML systems and AI infrastructure, especially
        efficient computation for large language models. I'm currently learning
        about attention kernels, GPU operator optimization, and system–model
        co-design.
      </p>
      <p>
        I use this site to share notes and things I'm working through. You can
        read more <a href={getRelativeLocaleUrl(locale, "about")}>about me</a>,
        find my code on <a href="https://github.com/RuixiZhang03">GitHub</a>, or <a
          href="mailto:zhangruixi25e@ict.ac.cn">send me an email</a
        >.
      </p>
    </section>

    <section class="home-writing" aria-labelledby="writing-title">
      <h2 id="writing-title">Posts</h2>
      <ul class="home-posts">
        {
          posts
            .slice(0, config.posts.perIndex)
            .map(post => <Card variant="h3" {...post} />)
        }
      </ul>
      {
        posts.length > config.posts.perIndex && (
          <a class="all-posts" href={getRelativeLocaleUrl(locale, "posts")}>
            More posts →
          </a>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    if (indexLayout?.layout)
      sessionStorage.setItem(
        "backUrl",
        indexLayout.homePath ?? import.meta.env.BASE_URL
      );
  });
</script>
