---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconUnderline from "@/assets/icons/IconUnderline.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;
const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);
const path = stripLocale(
  stripBase(Astro.url.pathname).replace(/\/+$/, "") || "/",
  locale
);
const active = (segment: string) =>
  path === segment || path.startsWith(`${segment}/`);
---

<a id="skip-to-content" href="#main-content" class="skip-link">
  {t.a11y.skipToContent}
</a>

<header class="app-layout site-header">
  <a class="site-name" href={getRelativeLocaleUrl(locale, "")}>{site.title}</a>
  <nav aria-label="Main navigation">
    <a
      href={getRelativeLocaleUrl(locale, "posts")}
      data-underline="posts"
      aria-current={active("/posts") ? "page" : undefined}
      >Posts{
        active("/posts") && (
          <IconUnderline class="nav-underline" aria-hidden="true" />
        )
      }</a
    >
    <a
      href={getRelativeLocaleUrl(locale, "tags")}
      data-underline="tags"
      aria-current={active("/tags") ? "page" : undefined}
      >Tags{
        active("/tags") && (
          <IconUnderline class="nav-underline" aria-hidden="true" />
        )
      }</a
    >
    {
      features.showArchives && (
        <a
          href={getRelativeLocaleUrl(locale, "archives")}
          data-underline="archives"
          aria-current={active("/archives") ? "page" : undefined}
        >
          Archive
          {active("/archives") && (
            <IconUnderline class="nav-underline" aria-hidden="true" />
          )}
        </a>
      )
    }
    {
      features.search !== false && (
        <a
          href={getRelativeLocaleUrl(locale, "search")}
          data-underline="search"
          aria-current={active("/search") ? "page" : undefined}
        >
          Search
          {active("/search") && (
            <IconUnderline class="nav-underline" aria-hidden="true" />
          )}
        </a>
      )
    }
    <a
      href={getRelativeLocaleUrl(locale, "about")}
      data-underline="about"
      aria-current={active("/about") ? "page" : undefined}
      >About{
        active("/about") && (
          <IconUnderline class="nav-underline" aria-hidden="true" />
        )
      }</a
    >
    {
      features.lightAndDarkMode && (
        <button
          id="theme-btn"
          class="theme-toggle"
          title={t.a11y.toggleTheme}
          aria-label="auto"
          aria-live="polite"
        >
          <IconMoon class="moon-icon" />
          <IconSunHigh class="sun-icon" />
        </button>
      )
    }
  </nav>
</header>

<script>
  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          { once: true }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }
  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>
